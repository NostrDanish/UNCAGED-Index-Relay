# Application configuration
PORT="13131"
RELAY_URL="wss://relay.example.com/"
NOSTR_NSEC=""

# OpenSearch configuration
OPENSEARCH_NODE="http://localhost:9200"
OPENSEARCH_INDEX="nostr-events"
OPENSEARCH_USERNAME=""
OPENSEARCH_PASSWORD=""

# History configuration (replaceable/addressable event versioning)
# HISTORY_ENABLED="true"
# HISTORY_KINDS_WHITELIST=""
# HISTORY_KINDS_EXCLUDED="30382,30383,30384,30385"

# Auth-protected kinds: require AUTH for REQ/COUNT, excluded from unscoped queries
# AUTH_KINDS="4,1059"

# Maximum inbound WebSocket message size in bytes (enforced AND advertised via NIP-11)
# RELAY_MAX_MESSAGE_LENGTH="4000000"

# Maximum number of entries in any single filter array (ids/authors/kinds/#tag)
# RELAY_MAX_FILTER_VALUES="5000"

# Maximum number of values indexed per tag name in tags_map (e.g. number of
# p-tags in a kind-3 contact list projected into tags_map.p). Default 5000
# matches NIP-11 max_event_tags so any compliant event is fully indexable.
# RELAY_TAG_VALUE_MAX_COUNT_PER_NAME="5000"
